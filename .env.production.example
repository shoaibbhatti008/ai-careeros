# ============================================================
# AI CareerOS — Production Environment Template
# ============================================================
# Copy to .env on the production server.
# NEVER commit the real .env.
# ============================================================

# ---- General ----
PROJECT_NAME=AI CareerOS
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=GENERATE_A_50_PLUS_CHAR_RANDOM_STRING
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
TIME_ZONE=UTC
LANGUAGE_CODE=en-us

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=https://your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# ---- Database ----
POSTGRES_DB=careeros
POSTGRES_USER=careeros
POSTGRES_PASSWORD=GENERATE_STRONG_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://careeros:GENERATE_STRONG_PASSWORD@postgres:5432/careeros

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- JWT ----
JWT_SECRET_KEY=GENERATE_ANOTHER_50_PLUS_CHAR_STRING
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ALGORITHM=HS256

# ---- AI ----
AI_PROVIDER=groq
AI_API_KEY=your-real-api-key
AI_MODEL=llama-3.3-70b-versatile
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048
AI_TIMEOUT_SECONDS=60

# ---- Embeddings ----
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
VECTOR_STORE=pgvector
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=6
RAG_SCORE_THRESHOLD=0.35

# ---- Safety Limits ----
MAX_AGENT_STEPS=12
MAX_TOOL_CALLS=20
MAX_WORKFLOW_SECONDS=120
MAX_RECURSION_DEPTH=3
AGENT_RATE_LIMIT_PER_MINUTE=30
TOOL_RATE_LIMIT_PER_MINUTE=60

# ---- Uploads ----
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt,.md
UPLOAD_TEMP_DIR=/app/temp/uploads

# ---- Email ----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@your-domain.com
EMAIL_HOST_PASSWORD=GENERATE_EMAIL_PASSWORD
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@your-domain.com

# ---- Frontend ----
FRONTEND_URL=https://your-domain.com
VITE_API_URL=/api
VITE_ENVIRONMENT=production

# ---- Observability ----
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_TRACING=True
SENTRY_DSN=

# ---- Features ----
FEATURE_RAG=True
FEATURE_INTERVIEW_AGENT=True
FEATURE_JOB_AGENT=True
FEATURE_APPROVAL_WORKFLOW=True
FEATURE_SECURITY_DASHBOARD=True