# ============================================================
# AI CareerOS - Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.
# ============================================================

# ---- General ----
PROJECT_NAME=AI CareerOS
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC
LANGUAGE_CODE=en-us

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Database (PostgreSQL) ----
POSTGRES_DB=careeros
POSTGRES_USER=careeros
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://careeros:change-me-to-a-strong-password@localhost:5432/careeros

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- JWT / Auth ----
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ALGORITHM=HS256

# ---- AI / LLM Providers ----
AI_PROVIDER=openai
AI_API_KEY=your-ai-api-key-here
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048
AI_TIMEOUT_SECONDS=60

AI_FALLBACK_PROVIDER=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=

# ---- Embeddings / RAG ----
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
VECTOR_STORE=pgvector
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=6
RAG_SCORE_THRESHOLD=0.35

# ---- Agent Safety Limits ----
MAX_AGENT_STEPS=12
MAX_TOOL_CALLS=20
MAX_WORKFLOW_SECONDS=120
MAX_RECURSION_DEPTH=3
AGENT_RATE_LIMIT_PER_MINUTE=30
TOOL_RATE_LIMIT_PER_MINUTE=60

# ---- File Uploads ----
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt,.md
UPLOAD_TEMP_DIR=./temp/uploads

# ---- Email ----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@careeros.local

# ---- Frontend ----
FRONTEND_URL=http://localhost:3000
REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_ENVIRONMENT=development

# ---- Observability ----
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_TRACING=True
SENTRY_DSN=

# ---- Feature Flags ----
FEATURE_RAG=True
FEATURE_INTERVIEW_AGENT=True
FEATURE_JOB_AGENT=True
FEATURE_APPROVAL_WORKFLOW=True
FEATURE_SECURITY_DASHBOARD=True

# ---- Docker Compose ----
COMPOSE_PROJECT_NAME=ai-careeros